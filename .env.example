# Required: at least 20 characters. Generate one with: openssl rand -hex 32
PAIR_TOKEN=
# mock = no API spend (default). live = calls Anthropic using the key below.
MODEL_MODE=mock
# Keep the key on the server only. Never commit .env.
ANTHROPIC_API_KEY=
# Optional. Must be a model with a verified price in server/main.ts (MODELS). Default: claude-haiku-5-5.
# The app never switches models by itself.
ANTHROPIC_MODEL=
# Optional. Address the published port binds to. Default 127.0.0.1 (use an SSH tunnel).
# For a private network (Tailscale/WireGuard) set this to the server's private-network IP.
BIND_ADDR=127.0.0.1
